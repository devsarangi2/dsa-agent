{
  "$schema": "https://antigravity.google/schemas/v1/settings.json",
  "agentMode": "accept-edits",
  "toolPermission": "always-proceed",
  "artifactReviewPolicy": "always-proceed",
  "trustedWorkspaces": [
    "/home/nox/Developer/ds2/dsa-agent"
  ],
  "permissions": {
    "allow": [
      "read_file(/home/nox/Developer/ds2/dsa-agent)",
      "write_file(/home/nox/Developer/ds2/dsa-agent)",
      "command(*)",
      "command(python)",
      "command(python3)",
      "command(regex:python3? .*)",
      "command(grep)",
      "command(regex:grep .*)",
      "command(bash)",
      "command(regex:bash .*)",
      "command(git)",
      "command(regex:git .*)",
      "command(git status)",
      "command(git add)",
      "command(git commit)",
      "command(git push)",
      "command(git pull)",
      "command(git fetch)",
      "command(git branch)",
      "command(git checkout)",
      "command(git switch)",
      "command(git merge)",
      "command(git rebase)",
      "command(git log)",
      "command(git diff)",
      "command(git show)",
      "command(git remote)",
      "command(git rev-parse)",
      "command(git worktree)",
      "command(git stash)",
      "command(git tag)",
      "command(git clone)",
      "command(git init)",
      "command(git reset)",
      "command(git restore)",
      "command(git rm)",
      "command(git mv)",
      "command(git config)",
      "command(git -C)",
      "command(gh)",
      "command(regex:gh .*)",
      "command(uv)",
      "command(regex:uv .*)",
      "command(pytest)",
      "command(regex:pytest .*)",
      "command(ruff)",
      "command(regex:ruff .*)",
      "command(mypy)",
      "command(regex:mypy .*)",
      "command(make)",
      "command(regex:make .*)",
      "read_url(*)",
      "execute_url(*)",
      "mcp(*)"
    ],
    "deny": [
      "command(rm -rf /)",
      "command(sudo)"
    ]
  }
}
